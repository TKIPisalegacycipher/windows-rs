//! --filter Test.IFoo::add_Click --filter Test.IFoo::remove_Click --flat --minimal
#[winrt]
mod Test {
    interface IFoo {
        #[special]
        fn add_Click(&self, handler: Handler) -> i64;
        #[special]
        fn remove_Click(&self, token: i64);
        fn Subscribe(&self, handler: Handler);
    }

    delegate fn Handler(sender: IFoo, args: i32);
}
